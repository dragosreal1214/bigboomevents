# ───────────────────────────────────────────────────────────
#  BigBoomEvents — variabile de mediu
#  Copiază în `.env` și completează valorile reale.
#  NU comite `.env` în git (e deja în .gitignore).
# ───────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=production
PORT=3000
# Origini permise pentru CORS (separate prin virgulă). În producție = domeniul tău.
CORS_ORIGINS=https://bigboomevents.ro,https://www.bigboomevents.ro
# URL public al site-ului (folosit în email-uri și redirect-uri de plată)
PUBLIC_URL=https://bigboomevents.ro

# --- PostgreSQL ---
# Fie DATABASE_URL, fie variabilele separate de mai jos.
DATABASE_URL=postgres://bigboom:PAROLA_PUTERNICA@localhost:5432/bigboomevents
PGHOST=localhost
PGPORT=5432
PGUSER=bigboom
PGPASSWORD=PAROLA_PUTERNICA
PGDATABASE=bigboomevents
# Pune true doar dacă DB-ul cere SSL (de obicei false pe localhost/VPS)
PGSSL=false

# --- Email tranzacțional (Resend SAU Brevo) ---
# Alege un singur provider: "resend", "brevo" sau "console" (loghează, nu trimite — pentru dev).
EMAIL_PROVIDER=console
EMAIL_FROM="BigBoomEvents <contact@bigboomevents.ro>"
# Unde primești notificările de comandă/lead nou
EMAIL_ADMIN=contact@bigboomevents.ro
# Resend
RESEND_API_KEY=
# Brevo (Sendinblue)
BREVO_API_KEY=

# --- Plăți: Netopia ---
# Mod: "sandbox" (test, fără bani reali) sau "live"
NETOPIA_MODE=sandbox
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
# Endpoint-uri Netopia v2 (lăsate explicit ca să le poți schimba)
NETOPIA_BASE_URL_SANDBOX=https://secure.sandbox.netopia-payments.com
NETOPIA_BASE_URL_LIVE=https://secure.netopia-payments.com

# --- Notificare instant opțională (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Securitate ---
# Secret folosit la semnarea/verificarea unor token-uri interne
APP_SECRET=schimba-ma-cu-un-string-lung-si-aleator

# --- Backoffice (panou admin /admin) ---
# Parola de login în panoul de administrare. OBLIGATORIU schimbată în producție.
ADMIN_PASSWORD=schimba-ma-cu-o-parola-puternica
# (opțional) Durata sesiunii admin în milisecunde. Implicit 12h.
ADMIN_SESSION_TTL_MS=43200000
# (opțional, producție) Director unde se salvează pozele urcate, servit de nginx.
# Ex: UPLOAD_DIR=/var/www/bigboom/assets/uploads
UPLOAD_DIR=
