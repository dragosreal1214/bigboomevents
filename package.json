{
  "name": "bigboomevents",
  "version": "1.0.0",
  "description": "BigBoomEvents — flori, baloane și evenimente. Site cu 3 pagini (hub, evenimente, shop) + backend Node.js + PostgreSQL.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/run-sql.js db/schema.sql",
    "db:seed": "node scripts/run-sql.js db/seed.sql",
    "db:reset": "node scripts/run-sql.js db/schema.sql && node scripts/run-sql.js db/seed.sql",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "license": "UNLICENSED",
  "private": true
}
